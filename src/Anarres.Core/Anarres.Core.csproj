<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Anarres.Core</RootNamespace>
  </PropertyGroup>

  <!-- DBC layouts and spell names generated from AzerothCore by tools/generate-definitions.py -->
  <ItemGroup>
    <EmbeddedResource Include="Definitions\*.json" LogicalName="Anarres.Core.Definitions.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="2.2.6" />
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anarres.Core.Tests" />
  </ItemGroup>

</Project>
