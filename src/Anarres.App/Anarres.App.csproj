<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Anarres</AssemblyName>
    <RootNamespace>Anarres.App</RootNamespace>
    <Version>0.1.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- The icon of Anarres.exe in Explorer and the taskbar; Assets/anarres.svg is its source -->
    <ApplicationIcon>Assets\anarres.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Avalonia's Linux D-Bus dependency; 0.21.3 fixes CVE-2026-39959 (GHSA-xrw6-gwf8-vvr9) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <!-- The interface tests reach the windows' parts -->
  <ItemGroup>
    <InternalsVisibleTo Include="Anarres.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anarres.Core\Anarres.Core.csproj" />
  </ItemGroup>

</Project>
